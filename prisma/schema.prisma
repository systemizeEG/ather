generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  title            String
  shortDescription String?
  fullDescription  String?
  categoryId       String?
  price            Float
  comparePrice     Float?
  image            String?
  stock            Int              @default(0)
  duration         String?
  deliveryType     String?
  features         String?
  tags             String?
  isFeatured       Boolean          @default(true)
  isPopular        Boolean          @default(false)
  status           String           @default("ACTIVE")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  category         Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems       OrderItem[]
  packages         ProductPackage[]

  @@index([categoryId])
  @@index([status])
}

model ProductPackage {
  id             String      @id @default(cuid())
  productId      String
  name           String
  description    String?
  quantity       Int
  price          Float
  compareAtPrice Float?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]

  @@index([productId])
  @@index([productId, isActive])
}

model Order {
  id                String      @id @default(cuid())
  orderId           String      @unique
  customerName      String
  phone             String
  whatsapp          String?
  email             String?
  notes             String?
  subtotal          Float
  total             Float
  discountCode      String?
  discountAmount    Float?      @default(0)
  paymentMethod     String      @default("INSTAPAY")
  paymentScreenshot String?
  status            String      @default("PENDING_PAYMENT_REVIEW")
  adminNote         String?
  userId            String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  user              User?       @relation(fields: [userId], references: [id])
  items             OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([discountCode])
  @@index([createdAt])
}

model OrderItem {
  id                      String          @id @default(cuid())
  orderId                 String
  productId               String?
  packageId               String?
  titleSnapshot           String
  priceSnapshot           Float
  quantity                Int
  packageNameSnapshot     String?
  packageQuantitySnapshot Int?
  product                 Product?        @relation(fields: [productId], references: [id])
  package                 ProductPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  order                   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@index([packageId])
}

model User {
  id                String            @id @default(cuid())
  name              String
  email             String            @unique
  passwordHash      String
  phone             String?
  role              String            @default("CUSTOMER")
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  orders            Order[]
  candidateProfile  CandidateProfile?

  @@index([role])
}

model CandidateProfile {
  id          String       @id @default(cuid())
  userId      String       @unique
  couponId    String       @unique
  targetType  String       @default("ORDERS")
  targetValue Float
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon      DiscountCode @relation(fields: [couponId], references: [id], onDelete: Restrict)

  @@index([couponId])
  @@index([isActive])
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Settings {
  id                   String   @id @default(cuid())
  instapayReceiverName String?
  instapayAccount      String?
  whatsappNumber       String?
  storeName            String?
  supportText          String?
  updatedAt            DateTime @updatedAt
}

model DiscountCode {
  id               String            @id @default(cuid())
  code             String            @unique
  percentage       Float
  isActive         Boolean           @default(true)
  usedCount        Int               @default(0)
  maxUses          Int?
  expiryDate       DateTime?
  type             String            @default("GENERAL")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  candidateProfile CandidateProfile?

  @@index([type])
  @@index([isActive])
}
