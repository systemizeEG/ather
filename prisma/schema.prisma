generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id               String      @id @default(cuid())
  slug             String      @unique
  title            String
  shortDescription String?
  fullDescription  String?
  category         String?
  price            Float
  comparePrice     Float?
  image            String?
  stock            Int         @default(0)
  duration         String?
  deliveryType     String?
  features         String?
  tags             String?
  isFeatured       Boolean     @default(true)
  isPopular        Boolean     @default(false)
  status           String      @default("ACTIVE")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  orderItems       OrderItem[]
}

model Order {
  id                String      @id @default(cuid())
  orderId           String      @unique
  customerName      String
  phone             String
  whatsapp          String?
  email             String?
  notes             String?
  subtotal          Float
  total             Float
  discountCode      String?
  discountAmount    Float? @default(0)
  paymentMethod     String      @default("INSTAPAY")
  paymentScreenshot String?
  status            String      @default("PENDING_PAYMENT_REVIEW")
  adminNote         String?
  userId            String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  user              User?       @relation(fields: [userId], references: [id])
  items             OrderItem[]
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String?
  titleSnapshot String
  priceSnapshot Float
  quantity      Int
  product       Product? @relation(fields: [productId], references: [id])
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Settings {
  id                   String   @id @default(cuid())
  instapayReceiverName String?
  instapayAccount      String?
  whatsappNumber       String?
  storeName            String?
  supportText          String?
  updatedAt            DateTime @updatedAt
}

model DiscountCode {
  id          String   @id @default(cuid())
  code        String   @unique
  percentage  Float
  isActive    Boolean  @default(true)
  usedCount   Int      @default(0)
  maxUses     Int?
  expiryDate  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
